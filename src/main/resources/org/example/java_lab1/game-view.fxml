<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.java_lab1.HelloController"
           prefWidth="900" prefHeight="620">
    <VBox fx:id="connectScreen"
          alignment="CENTER" spacing="15"
          style="-fx-background-color: #f0f0f0;">

        <Label text="Меткий стрелок"
               style="-fx-font-size: 28; -fx-font-weight: bold;"/>

        <Label text="Введите имя игрока:"/>
        <TextField fx:id="nameField"
                   promptText="Ваше имя"
                   maxWidth="200"/>

        <Button text="Подключиться"
                onAction="#onConnect"
                defaultButton="true"
                style="-fx-font-size: 14;"/>

        <Label fx:id="connectErrorLabel"
               style="-fx-text-fill: red;"/>
    </VBox>


    <HBox fx:id="gameScreen" visible="false">

        <!-- Игровое поле -->
        <VBox>
            <Pane fx:id="gameField"
                  prefWidth="650" prefHeight="460"
                  style="-fx-background-color: lightblue;"/>

            <!-- Кнопки управления -->
            <HBox spacing="10" style="-fx-padding: 10;">
                <Button text="Готов"        onAction="#onReady"/>
                <Button text="Остановить"   onAction="#onStopGame"/>
                <Button fx:id="pauseButton" text="Пауза" onAction="#onPauseGame"/>
                <Button text="Выстрел"      onAction="#onShoot"/>
            </HBox>
        </VBox>

        <!-- Панель игроков справа -->
        <VBox fx:id="playersPanel"
              spacing="10"
              style="-fx-padding: 15; -fx-background-color: #eeeeee; -fx-min-width: 200;">

            <Label text="Игроки:"
                   style="-fx-font-size: 16; -fx-font-weight: bold;"/>

            <!-- Сюда динамически добавляем карточки игроков из кода -->
            <VBox fx:id="playersList" spacing="8"/>
        </VBox>

    </HBox>

</StackPane>